            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">25</stringProp>
              <stringProp name="content">00</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">POS Condition Code</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">35</stringProp>
