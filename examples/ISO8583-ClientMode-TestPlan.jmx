            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">2</stringProp>
              <stringProp name="content">4111111111111111</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">PAN</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">3</stringProp>
              <stringProp name="content">000000</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Processing Code - Purchase</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">4</stringProp>
              <stringProp name="content">000000005000</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Amount - $50.00</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">7</stringProp>
              <stringProp name="content">${__time(MMddHHmmss)}</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Transmission Date/Time</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">11</stringProp>
              <stringProp name="content">${__Random(100000,999999)}</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">STAN</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">14</stringProp>
              <stringProp name="content">2512</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Expiry Date - Dec 2025</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">22</stringProp>
              <stringProp name="content">051</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">POS Entry Mode</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">41</stringProp>
              <stringProp name="content">TERM0001</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Terminal ID</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">42</stringProp>
              <stringProp name="content">MERCHANT00000001</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Merchant ID</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">49</stringProp>
              <stringProp name="content">840</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Currency Code - USD</stringProp>
            </elementProp>
          </collectionProp>
          <collectionProp name="responseCodePattern">
            <stringProp name="field">39</stringProp>
            <stringProp name="pattern">00</stringProp>
          </collectionProp>
          <collectionProp name="responseValidation"/>
        </nz.co.breakpoint.jmeter.iso8583.ISO8583Sampler>
        <hashTree/>

        <!-- 0200 Purchase Transaction -->
