            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">12</stringProp>
              <stringProp name="content">${__time(HHmmss)}</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">Local Time</stringProp>
