            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">22</stringProp>
              <stringProp name="content">051</stringProp>
              <stringProp name="tag"></stringProp>
              <stringProp name="comment">POS Entry Mode - Chip</stringProp>
            </elementProp>
            <elementProp name="" elementType="nz.co.breakpoint.jmeter.iso8583.MessageField">
              <stringProp name="id">23</stringProp>
