          <elementProp name="Default" elementType="TxnMgrTreeNode" testname="Default">
            <intProp name="nodeId">50</intProp>
            <intProp name="parentId">-1</intProp>
            <stringProp name="nodeType">GROUP</stringProp>
          </elementProp>
          <elementProp name="" elementType="TxnMgrTreeNode">
            <intProp name="nodeId">51</intProp>
            <intProp name="parentId">50</intProp>
            <stringProp name="nodeType">SCRIPT</stringProp>
            <stringProp name="scriptName">Default Handler</stringProp>
            <stringProp name="scriptContent">// Default Handler - Handles unknown MTIs
import org.jpos.iso.ISOMsg;
import org.jpos.iso.ISOSource;

if (phase.equals(&quot;prepare&quot;)) {
    ISOMsg msg = (ISOMsg) ctx.get(&quot;REQUEST&quot;);
    ISOSource src = (ISOSource) ctx.get(&quot;SOURCE&quot;);
    log.warn(&quot;Default Handler: Received unsupported MTI=&quot; + msg.getMTI());

    // Create error response
    ISOMsg response = (ISOMsg) msg.clone();
    response.setResponseMTI();
    response.set(39, &quot;12&quot;); // Invalid transaction

    // Send response in prepare phase while channel is still connected
    if (src != null) {
        src.send(response);
        log.warn(&quot;Default Handler: Sent decline response MTI=&quot; + response.getMTI());
    }

    ctx.put(&quot;RESPONSE&quot;, response);
    result = PREPARED | NO_JOIN;
}
</stringProp>
